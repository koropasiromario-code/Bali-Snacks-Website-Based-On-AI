# Salin file ini menjadi .env dan isi nilai yang kuat.
# Aplikasi belum membaca .env otomatis; ekspor variabel di terminal atau gunakan python-dotenv.
SECRET_KEY=ganti-dengan-random-secret-yang-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
WHATSAPP_NUMBER=6281234567890
# COOKIE_SECURE=1 hanya jika website sudah menggunakan HTTPS.
COOKIE_SECURE=0
# FLASK_DEBUG=0 untuk pemakaian normal.
FLASK_DEBUG=0
